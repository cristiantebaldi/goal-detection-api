FROM golang:1.27.1-alpine3.24

RUN apk add --no-cache git curl build-base

WORKDIR /api

RUN go install github.com/air-verse/air@latest

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080

CMD ["/bin/sh", "-c", "chmod +x /api/scripts/change_vars_config.sh && /api/scripts/change_vars_config.sh /api && air"]
